<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0A1128"/>
      <stop offset="50%" stop-color="#0F172A"/>
      <stop offset="100%" stop-color="#1E293B"/>
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F3E5AB"/>
      <stop offset="50%" stop-color="#D4A017"/>
      <stop offset="100%" stop-color="#AA7C11"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#D4A017" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#0A1128" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="800" height="600" fill="url(#bgGrad)"/>
  <rect width="800" height="600" fill="url(#glow)"/>

  <!-- Subtle Architectural Grid Pattern -->
  <g opacity="0.08" stroke="#D4A017" stroke-width="1">
    <line x1="0" y1="100" x2="800" y2="100"/>
    <line x1="0" y1="200" x2="800" y2="200"/>
    <line x1="0" y1="300" x2="800" y2="300"/>
    <line x1="0" y1="400" x2="800" y2="400"/>
    <line x1="0" y1="500" x2="800" y2="500"/>
    <line x1="160" y1="0" x2="160" y2="600"/>
    <line x1="320" y1="0" x2="320" y2="600"/>
    <line x1="480" y1="0" x2="480" y2="600"/>
    <line x1="640" y1="0" x2="640" y2="600"/>
  </g>

  <!-- Supreme Court Architectural Colonade Representation -->
  <g transform="translate(150, 120)">
    <!-- Pediment (Triangular roof) -->
    <polygon points="250,40 50,110 450,110" fill="none" stroke="url(#goldGrad)" stroke-width="3"/>
    <line x1="50" y1="110" x2="450" y2="110" stroke="url(#goldGrad)" stroke-width="4"/>
    <line x1="70" y1="125" x2="430" y2="125" stroke="url(#goldGrad)" stroke-width="2"/>

    <!-- Columns -->
    <g stroke="url(#goldGrad)" stroke-width="3" fill="none">
      <!-- Column 1 -->
      <line x1="100" y1="125" x2="100" y2="260"/>
      <line x1="110" y1="125" x2="110" y2="260"/>
      <!-- Column 2 -->
      <line x1="170" y1="125" x2="170" y2="260"/>
      <line x1="180" y1="125" x2="180" y2="260"/>
      <!-- Column 3 -->
      <line x1="245" y1="125" x2="245" y2="260"/>
      <line x1="255" y1="125" x2="255" y2="260"/>
      <!-- Column 4 -->
      <line x1="320" y1="125" x2="320" y2="260"/>
      <line x1="330" y1="125" x2="330" y2="260"/>
      <!-- Column 5 -->
      <line x1="390" y1="125" x2="390" y2="260"/>
      <line x1="400" y1="125" x2="400" y2="260"/>
    </g>

    <!-- Base / Plinth -->
    <rect x="40" y="260" width="420" height="20" fill="none" stroke="url(#goldGrad)" stroke-width="3"/>
    <line x1="20" y1="280" x2="480" y2="280" stroke="url(#goldGrad)" stroke-width="4"/>

    <!-- Center Emblem: Scales of Justice in Pediment -->
    <g transform="translate(250, 80) scale(0.65)" stroke="url(#goldGrad)" stroke-width="2.5" fill="none">
      <line x1="0" y1="-20" x2="0" y2="25"/>
      <line x1="-30" y1="-10" x2="30" y2="-10"/>
      <!-- Left pan -->
      <line x1="-30" y1="-10" x2="-45" y2="10"/>
      <line x1="-30" y1="-10" x2="-15" y2="10"/>
      <path d="M-48,10 Q-30,22 -12,10 Z" fill="url(#goldGrad)" opacity="0.3"/>
      <!-- Right pan -->
      <line x1="30" y1="-10" x2="15" y2="10"/>
      <line x1="30" y1="-10" x2="45" y2="10"/>
      <path d="M12,10 Q30,22 48,10 Z" fill="url(#goldGrad)" opacity="0.3"/>
      <!-- Base -->
      <path d="M-15,25 L15,25" stroke-width="3"/>
    </g>
  </g>

  <!-- Typography Banner -->
  <g text-anchor="middle" font-family="'Cinzel', 'Times New Roman', serif">
    <text x="400" y="470" fill="url(#goldGrad)" font-size="20" font-weight="600" letter-spacing="4">
      SUPREME COURT OF BANGLADESH
    </text>
    <text x="400" y="505" fill="#94A3B8" font-size="13" font-family="'Inter', sans-serif" letter-spacing="2">
      JUDICIAL HERITAGE &amp; INSTITUTIONAL ARCHIVE
    </text>
  </g>

  <!-- Elegant Inner Border -->
  <rect x="25" y="25" width="750" height="550" fill="none" stroke="url(#goldGrad)" stroke-width="1.5" opacity="0.4"/>
  <rect x="35" y="35" width="730" height="530" fill="none" stroke="#D4A017" stroke-width="0.5" opacity="0.2"/>
</svg>
